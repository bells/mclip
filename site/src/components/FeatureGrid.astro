---
interface Feature {
  title: string;
  body: string;
}

interface Props {
  id: string;
  title: string;
  features: Feature[];
}

const { id, title, features } = Astro.props;
---

<section class="section" id={id}>
  <div class="section-heading">
    <h2>{title}</h2>
  </div>
  <div class="feature-list">
    {
      features.map((feature) => (
        <article class="feature-row">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))
    }
  </div>
</section>
