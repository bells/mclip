---
interface InstallItem {
  title: string;
  body: string;
}

interface Props {
  id: string;
  title: string;
  intro: string;
  items: InstallItem[];
}

const { id, title, intro, items } = Astro.props;
---

<section class="section install-section" id={id}>
  <div class="section-heading narrow">
    <h2>{title}</h2>
    <p>{intro}</p>
  </div>
  <div class="install-board">
    {
      items.map((item) => (
        <article class="install-row">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))
    }
  </div>
</section>
