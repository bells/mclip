---
interface Props {
  lang: "zh" | "en";
  title: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
  note: string;
  utilityLabel: string;
  proofItems: string[];
}

const {
  lang,
  title,
  description,
  primaryCta,
  secondaryCta,
  note,
  utilityLabel,
  proofItems,
} = Astro.props;
const switchHref = lang === "zh" ? "/en/" : "/zh/";
const switchLabel = lang === "zh" ? "English" : "中文";
---

<header class="site-hero">
  <nav class="topbar" aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
    <a class="brand" href={lang === "zh" ? "/zh/" : "/en/"} aria-label="mclip">
      <img src="/app-icon.png" alt="" />
      <span>mclip</span>
    </a>
    <div class="nav-links">
      <a href="#features">{lang === "zh" ? "功能" : "Features"}</a>
      <a href="#agents">{lang === "zh" ? "Agent/CLI" : "Agent CLI"}</a>
      <a href="#install">{lang === "zh" ? "安装" : "Install"}</a>
      <a href="#faq">{lang === "zh" ? "FAQ" : "FAQ"}</a>
      <a href={switchHref}>{switchLabel}</a>
    </div>
  </nav>

  <div class="hero-shell">
    <div class="hero-content">
      <p class="utility-label">{utilityLabel}</p>
      <h1>{title}</h1>
      <p class="hero-copy">{description}</p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/bells/mclip/releases">
          {primaryCta}
        </a>
        <a class="button secondary" href="https://github.com/bells/mclip">
          {secondaryCta}
        </a>
      </div>
      <p class="hero-note">{note}</p>
    </div>

    <figure class="hero-figure">
      <video
        class="hero-product"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/videos/mclip-v0.1.1-demo-poster.png"
        width="1280"
        height="960"
        aria-label={
          lang === "zh"
            ? "mclip 搜索、选择和独立详情预览演示"
            : "mclip search, selection, and independent detail preview demo"
        }
        data-hero-demo
      >
        <source src="/videos/mclip-v0.1.1-demo.mp4" type="video/mp4" />
        <img
          src="/videos/mclip-v0.1.1-demo-poster.png"
          alt={lang === "zh" ? "mclip 主窗口与独立详情预览" : "mclip main window and independent detail preview"}
          width="1280"
          height="960"
        />
      </video>
      <figcaption>
        {
          lang === "zh"
            ? "搜索、选择、独立详情与复制，一次完成。"
            : "Search, select, preview independently, and copy."
        }
      </figcaption>
    </figure>
  </div>

  <ul class="proof-strip" aria-label={lang === "zh" ? "产品摘要" : "Product summary"}>
    {proofItems.map((item) => <li>{item}</li>)}
  </ul>
</header>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const heroVideos = document.querySelectorAll<HTMLVideoElement>("[data-hero-demo]");

  const syncHeroMotion = () => {
    heroVideos.forEach((video) => {
      if (reducedMotion.matches) {
        video.pause();
        return;
      }
      void video.play().catch(() => undefined);
    });
  };

  syncHeroMotion();
  reducedMotion.addEventListener("change", syncHeroMotion);
</script>
