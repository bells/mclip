---
import { localizedPath, type SiteLocale } from "../i18n/locales";
import LanguageNav from "./LanguageNav.astro";

interface Props {
  lang: SiteLocale;
  title: string;
  titleAccent: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
  utilityLabel: string;
  proofItems: string[];
}

const {
  lang,
  title,
  titleAccent,
  description,
  primaryCta,
  secondaryCta,
  utilityLabel,
  proofItems,
} = Astro.props;

const copy: Record<
  SiteLocale,
  {
    agents: string;
    demoAlt: string;
    demoCaption: string;
    demoLabel: string;
    features: string;
    install: string;
    mainNavigation: string;
    productSummary: string;
    pause: string;
    play: string;
    shortcut: string;
  }
> = {
  zh: {
    agents: "Agent/CLI",
    demoAlt: "mclip 主窗口与独立详情预览",
    demoCaption: "搜索、选择、独立详情与复制，一次完成。",
    demoLabel: "mclip 搜索、选择和独立详情预览演示",
    features: "功能",
    install: "安装",
    mainNavigation: "主导航",
    productSummary: "产品摘要",
    pause: "暂停演示",
    play: "播放演示",
    shortcut: "快捷唤起",
  },
  en: {
    agents: "Agent CLI",
    demoAlt: "mclip main window and independent detail preview",
    demoCaption: "Search, select, preview independently, and copy.",
    demoLabel: "mclip search, selection, and independent detail preview demo",
    features: "Features",
    install: "Install",
    mainNavigation: "Main navigation",
    productSummary: "Product summary",
    pause: "Pause demo",
    play: "Play demo",
    shortcut: "Open with a shortcut",
  },
  ja: {
    agents: "Agent CLI",
    demoAlt: "mclip のメインウィンドウと独立した詳細プレビュー",
    demoCaption: "検索、選択、独立プレビュー、コピーをすばやく完了。",
    demoLabel: "mclip の検索、選択、独立した詳細プレビューのデモ",
    features: "機能",
    install: "インストール",
    mainNavigation: "メインナビゲーション",
    productSummary: "製品概要",
    pause: "デモを一時停止",
    play: "デモを再生",
    shortcut: "ショートカットで開く",
  },
};
const t = copy[lang];
const homePath = localizedPath(lang, "/en/");
---

<header class="site-hero">
  <nav class="topbar" aria-label={t.mainNavigation}>
    <a class="brand" href={homePath} aria-label="mclip">
      <img src="/app-icon.png" alt="" />
      <span>mclip</span>
    </a>
    <div class="nav-links">
      <a href="#features">{t.features}</a>
      <a href="#agents">{t.agents}</a>
      <a href="#install">{t.install}</a>
      <a href="#faq">FAQ</a>
      <LanguageNav lang={lang} path={homePath} />
    </div>
  </nav>

  <div class="hero-shell">
    <div class="hero-content">
      <h1><span>{title}</span>{" "}<span>{titleAccent}</span></h1>
      <p class="hero-copy">{description}</p>
      <div class="hero-actions">
        <a class="button primary" href="#install">
          {primaryCta}
        </a>
        <a class="button secondary" href="https://github.com/bells/mclip">
          {secondaryCta}
        </a>
      </div>
      <p class="utility-label">{utilityLabel}</p>
      <p class="shortcut-hint" aria-label={`${t.shortcut}: CommandOrControl+Shift+V`}>
        <kbd>⌘ / Ctrl</kbd><span aria-hidden="true">+</span><kbd>Shift</kbd><span aria-hidden="true">+</span><kbd>V</kbd>
      </p>
    </div>

    <figure class="hero-figure">
      <video
        class="hero-product"
        loop
        muted
        playsinline
        preload="metadata"
        controls
        poster="/videos/mclip-v0.2.0-demo-poster.png"
        width="1280"
        height="960"
        aria-label={t.demoLabel}
        data-hero-demo
      >
        <source src="/videos/mclip-v0.2.0-demo.mp4" type="video/mp4" />
        <img
          src="/videos/mclip-v0.2.0-demo-poster.png"
          alt={t.demoAlt}
          width="1280"
          height="960"
        />
      </video>
      <figcaption>
        <span>{t.demoCaption}</span>
        <button type="button" data-demo-toggle data-play-label={t.play} data-pause-label={t.pause} hidden>{t.play}</button>
      </figcaption>
    </figure>
  </div>

  <ul class="proof-strip" aria-label={t.productSummary}>
    {proofItems.map((item) => <li>{item}</li>)}
  </ul>
</header>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const heroVideos = document.querySelectorAll<HTMLVideoElement>("[data-hero-demo]");
  heroVideos.forEach((video) => {
    const button = video.closest("figure")?.querySelector<HTMLButtonElement>("[data-demo-toggle]");
    if (!button) return;
    button.hidden = false;
    const syncLabel = () => {
      button.textContent = (video.paused ? button.dataset.playLabel : button.dataset.pauseLabel) ?? "";
    };
    const play = () => { void video.play().catch(syncLabel); };
    button.addEventListener("click", () => video.paused ? play() : video.pause());
    video.addEventListener("play", syncLabel);
    video.addEventListener("pause", syncLabel);
    // Native controls remain usable without JavaScript; reduced motion starts on the poster.
    const syncMotion = () => reducedMotion.matches ? video.pause() : play();
    syncMotion();
    reducedMotion.addEventListener("change", syncMotion);
  });
</script>
