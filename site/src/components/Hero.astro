---
interface Props {
  lang: "zh" | "en";
  title: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
  note: string;
  utilityLabel: string;
  proofItems: string[];
}

const {
  lang,
  title,
  description,
  primaryCta,
  secondaryCta,
  note,
  utilityLabel,
  proofItems,
} = Astro.props;
const switchHref = lang === "zh" ? "/en/" : "/zh/";
const switchLabel = lang === "zh" ? "English" : "中文";
---

<header class="site-hero">
  <nav class="topbar" aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
    <a class="brand" href={lang === "zh" ? "/zh/" : "/en/"} aria-label="mclip">
      <img src="/app-icon.png" alt="" />
      <span>mclip</span>
    </a>
    <div class="nav-links">
      <a href="#features">{lang === "zh" ? "功能" : "Features"}</a>
      <a href="#install">{lang === "zh" ? "安装" : "Install"}</a>
      <a href="#faq">{lang === "zh" ? "FAQ" : "FAQ"}</a>
      <a href={switchHref}>{switchLabel}</a>
    </div>
  </nav>

  <div class="hero-shell">
    <div class="hero-content">
      <p class="utility-label">{utilityLabel}</p>
      <h1>{title}</h1>
      <p class="hero-copy">{description}</p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/bells/mclip/releases">
          {primaryCta}
        </a>
        <a class="button secondary" href="https://github.com/bells/mclip">
          {secondaryCta}
        </a>
      </div>
      <p class="hero-note">{note}</p>
    </div>

    <figure class="hero-figure">
      <img
        class="hero-product"
        src="/screenshots/mclip-product-preview.png"
        alt={lang === "zh" ? "mclip 主窗口与历史预览界面" : "mclip main window and history preview"}
        width="640"
        height="672"
      />
      <figcaption>
        {
          lang === "zh"
            ? "主窗口、分组预览、单条详情分别保持独立。"
            : "Main window, grouped preview, and item detail stay separate."
        }
      </figcaption>
    </figure>
  </div>

  <ul class="proof-strip" aria-label={lang === "zh" ? "产品摘要" : "Product summary"}>
    {proofItems.map((item) => <li>{item}</li>)}
  </ul>
</header>
