---
import { localizedPath, type SiteLocale } from "../i18n/locales";
import LanguageNav from "./LanguageNav.astro";

interface Props {
  lang: SiteLocale;
  title: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
  note: string;
  utilityLabel: string;
  proofItems: string[];
}

const {
  lang,
  title,
  description,
  primaryCta,
  secondaryCta,
  note,
  utilityLabel,
  proofItems,
} = Astro.props;

const copy: Record<
  SiteLocale,
  {
    agents: string;
    demoAlt: string;
    demoCaption: string;
    demoLabel: string;
    features: string;
    install: string;
    mainNavigation: string;
    productSummary: string;
  }
> = {
  zh: {
    agents: "Agent/CLI",
    demoAlt: "mclip 主窗口与独立详情预览",
    demoCaption: "搜索、选择、独立详情与复制，一次完成。",
    demoLabel: "mclip 搜索、选择和独立详情预览演示",
    features: "功能",
    install: "安装",
    mainNavigation: "主导航",
    productSummary: "产品摘要",
  },
  en: {
    agents: "Agent CLI",
    demoAlt: "mclip main window and independent detail preview",
    demoCaption: "Search, select, preview independently, and copy.",
    demoLabel: "mclip search, selection, and independent detail preview demo",
    features: "Features",
    install: "Install",
    mainNavigation: "Main navigation",
    productSummary: "Product summary",
  },
  ja: {
    agents: "Agent CLI",
    demoAlt: "mclip のメインウィンドウと独立した詳細プレビュー",
    demoCaption: "検索、選択、独立プレビュー、コピーをすばやく完了。",
    demoLabel: "mclip の検索、選択、独立した詳細プレビューのデモ",
    features: "機能",
    install: "インストール",
    mainNavigation: "メインナビゲーション",
    productSummary: "製品概要",
  },
};
const t = copy[lang];
const homePath = localizedPath(lang, "/en/");
---

<header class="site-hero">
  <nav class="topbar" aria-label={t.mainNavigation}>
    <a class="brand" href={homePath} aria-label="mclip">
      <img src="/app-icon.png" alt="" />
      <span>mclip</span>
    </a>
    <div class="nav-links">
      <a href="#features">{t.features}</a>
      <a href="#agents">{t.agents}</a>
      <a href="#install">{t.install}</a>
      <a href="#faq">FAQ</a>
      <LanguageNav lang={lang} path={homePath} />
    </div>
  </nav>

  <div class="hero-shell">
    <div class="hero-content">
      <p class="utility-label">{utilityLabel}</p>
      <h1>{title}</h1>
      <p class="hero-copy">{description}</p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/bells/mclip/releases">
          {primaryCta}
        </a>
        <a class="button secondary" href="https://github.com/bells/mclip">
          {secondaryCta}
        </a>
      </div>
      <p class="hero-note">{note}</p>
    </div>

    <figure class="hero-figure">
      <video
        class="hero-product"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/videos/mclip-v0.1.1-demo-poster.png"
        width="1280"
        height="960"
        aria-label={t.demoLabel}
        data-hero-demo
      >
        <source src="/videos/mclip-v0.1.1-demo.mp4" type="video/mp4" />
        <img
          src="/videos/mclip-v0.1.1-demo-poster.png"
          alt={t.demoAlt}
          width="1280"
          height="960"
        />
      </video>
      <figcaption>{t.demoCaption}</figcaption>
    </figure>
  </div>

  <ul class="proof-strip" aria-label={t.productSummary}>
    {proofItems.map((item) => <li>{item}</li>)}
  </ul>
</header>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const heroVideos = document.querySelectorAll<HTMLVideoElement>("[data-hero-demo]");

  const syncHeroMotion = () => {
    heroVideos.forEach((video) => {
      if (reducedMotion.matches) {
        video.pause();
        return;
      }
      void video.play().catch(() => undefined);
    });
  };

  syncHeroMotion();
  reducedMotion.addEventListener("change", syncHeroMotion);
</script>
