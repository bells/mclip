---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  id: string;
  title: string;
  summary: string;
  items: FaqItem[];
}

const { id, title, summary, items } = Astro.props;
---

<section class="section faq-section" id={id}>
  <div class="section-heading">
    <h2>{title}</h2>
    <p>{summary}</p>
  </div>
  <div class="faq-list">
    {
      items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
