---
interface AgentCliPoint {
  title: string;
  body: string;
}

interface Props {
  id: string;
  title: string;
  summary: string;
  installLabel: string;
  installCommand: string;
  exampleLabel: string;
  examples: string[];
  points: AgentCliPoint[];
  note: string;
  moreLabel: string;
  installNoteLabel: string;
}

const {
  id,
  title,
  summary,
  installLabel,
  installCommand,
  exampleLabel,
  examples,
  points,
  note,
  moreLabel,
  installNoteLabel,
} = Astro.props;
---

<section class="section agent-cli-section" id={id}>
  <div class="agent-cli-board">
    <div class="agent-cli-copy">
      <h2>{title}</h2>
      <p>{summary}</p>
      <div class="agent-points">
        {
          points.map((point) => (
            <article>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="agent-terminal" aria-label={title}>
      <p class="terminal-label">{installLabel}</p>
      <pre><code>{installCommand}</code></pre>
      <p class="terminal-label">{exampleLabel}</p>
      <pre><code>{examples.slice(0, 3).join("\n\n")}</code></pre>
      <details class="more-commands">
        <summary>{moreLabel}</summary>
        <pre><code>{examples.slice(3).join("\n\n")}</code></pre>
      </details>
    </div>
  </div>
  <details class="cli-install-notes">
    <summary>{installNoteLabel}</summary>
    <p class="agent-cli-note">{note}</p>
  </details>
</section>
