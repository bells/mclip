---
import AgentCliSection from "../../components/AgentCliSection.astro";
import Faq from "../../components/Faq.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import Hero from "../../components/Hero.astro";
import InstallGuide from "../../components/InstallGuide.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  {
    title: "Tray-first",
    body: "Click the menu bar or system tray icon, or press CommandOrControl+Shift+V. v0.1.1 keeps only the main window on the startup path, warms previews, and creates low-frequency windows on demand; measured tray-ready median improved 51.3% on an Apple M2.",
  },
  {
    title: "Text, images, and files",
    body: "mclip keeps text snippets, screenshots, and files from Finder or File Explorer. Pin up to 100 frequently reused items ahead of ordinary history without consuming the main or archive count. Selecting file history restores a system file list rather than path-only text, while details still show the full absolute path and name.",
  },
  {
    title: "Compact, independent previews",
    body: "The latest 10 items stay compact by default, with tighter text/file rows that do not shrink image rows. Older history stays grouped and hover details remain independent. Image details can open in a dedicated maximized viewer, restore, and close with Escape.",
  },
  {
    title: "Search and keyboard flow",
    body: "Type to filter, use arrow keys to move, press Enter to copy, and hit Escape to hide. Search, keyboard, and pointer input share one active target across history, groups, and footer actions.",
  },
  {
    title: "Local-first privacy",
    body: "Clipboard history, settings, and image assets stay on your computer. The in-development v0.2.0 uses bounded heuristics to classify and mask high-confidence sensitive text by default and can exclude configured source applications; both controls can miss or misclassify content.",
  },
  {
    title: "Themes, languages, and platforms",
    body: "mclip supports macOS and Windows and follows system appearance and language. New installs keep 200 items by default, configurable up to 500, with controls for list counts, row numbers, and branding. The Agent CLI tab safely installs, upgrades, or reinstalls the matching version.",
  },
];

const agentCliPoints = [
  {
    title: "Agent Mode in one command",
    body: "mclip-cli agent --last 5 --json emits recent history, command capabilities, and safety boundaries for Codex, Claude Code, Cursor, and Cline.",
  },
  {
    title: "Controlled actions, no desktop noise",
    body: "agent/list/get/search/context are read-only and support pinned filtering. pin/unpin mutate one stable item; clear --yes --keep-pinned removes ordinary history while preserving pins.",
  },
  {
    title: "Built for errors, code, and prompts",
    body: "Agent Mode defaults to Markdown and supports JSON. transform composes JSON, Base64, and URL-component operations over stdin/stdout, while copy accepts one stdin source. Neither mode directly mutates history.",
  },
];

const installItems = [
  {
    title: "macOS",
    body: "Download the DMG from GitHub Releases and drag mclip.app into Applications. The current build is not notarized, so macOS may quarantine it after browser download.",
  },
  {
    title: "Windows",
    body: "Download the MSI or EXE installer and follow the setup wizard. The current installer is unsigned, so Windows SmartScreen may show an unknown-publisher warning.",
  },
  {
    title: "Developers",
    body: "The source code is open on GitHub. The app uses Tauri 2, React 19, TypeScript, and Rust, and runs locally with npm run tauri:dev.",
  },
];

const faqItems = [
  {
    question: "Does mclip upload my clipboard contents?",
    answer: "No. History, settings, and generated image assets stay on your computer in the local app configuration directory. The Windows installer may only access the network to install WebView2 when it is missing.",
  },
  {
    question: "Is sensitive-content masking encryption?",
    answer: "No. The in-development v0.2.0 mask protects the UI and default CLI output, while original history remains local plaintext so copy stays exact. Detection and source identity are best-effort and can produce false results; source-application exclusion is currently unavailable on pure Wayland.",
  },
  {
    question: "What if macOS says the app is damaged?",
    answer: "The current macOS build uses ad-hoc signing and is not notarized with an Apple Developer ID. After dragging mclip.app into Applications, you can run xattr -dr com.apple.quarantine /Applications/mclip.app if you trust the release.",
  },
  {
    question: "Is the Windows SmartScreen warning expected?",
    answer: "Yes for now. The Windows package is not code-signed yet, so SmartScreen may warn about an unknown publisher. Install only GitHub Releases you trust.",
  },
  {
    question: "How many items can mclip keep?",
    answer: "New installs keep up to 200 items by default, configurable from 10 to 500. Main-window and archive-group counts are separate, and mclip can save text, images, files, or only selected types.",
  },
];
---

<SiteLayout
  lang="en"
  path="/en/"
  title="mclip - Lightweight, local-first clipboard history"
  description="mclip is a local-first clipboard history app for macOS and Windows, with text, image, and file history, independent previews, tray shortcuts, and an AI Agent CLI with Agent Mode."
  faqItems={faqItems}
>
  <Hero
    lang="en"
    title="Lightweight, local-first clipboard history"
    description="mclip lives in the menu bar or system tray. Open it when you need a previous text snippet, image, or file, then return to work without a large window taking over."
    primaryCta="Download mclip"
    secondaryCta="View on GitHub"
    note="Current version 0.1.1. Downloads are served from GitHub Releases."
    utilityLabel="Menu bar on macOS · System tray on Windows"
    proofItems={[
      "Measured tray-ready median improved 51.3% on Apple M2",
      "Text, images, files, and a dedicated image viewer",
      "Revisioned updates and image caching stay local",
    ]}
  />

  <FeatureGrid
    id="features"
    title="Keep copy history close without adding noise"
    summary="The page mirrors the product flow: open the tray window, search, preview, copy, then get back to the task you were doing."
    features={features}
  />

  <AgentCliSection
    id="agents"
    eyebrow="For developers and AI agents"
    title="AI Agent and CLI"
    summary="mclip-cli gives Codex, Claude Code, Cursor, and Cline a local terminal entry into clipboard history. Agent Mode bundles recent history, available commands, and safety boundaries so agents do not need you to paste the same snippet again."
    installLabel="Install mclip-cli"
    installCommand="curl -fsSL https://www.mclip.cn/install.sh | sh"
    exampleLabel="Common commands"
    examples={[
      "mclip-cli agent --last 5 --json",
      "mclip-cli list --limit 5 --json",
      "mclip-cli context --last 3 --format markdown",
      "mclip-cli add \"note from agent\"",
      "mclip-cli copy --index 1",
      "printf '%s' '{\"ok\":true}' | mclip-cli transform json-prettify",
      "printf '%s' 'pipeline clipboard text' | mclip-cli copy",
      "mclip-cli pin --id h_xxx",
      "mclip-cli list --pinned --json",
    ]}
    points={agentCliPoints}
    note="The installer downloads the prebuilt mclip-cli and SHA-256 companion from the same GitHub Release, verifies it before replacing an older CLI, and accepts MCLIP_VERSION for pinned installs. It falls back to a source build only when the binary asset is missing. Windows CLI users should run it from Git Bash or another POSIX-compatible shell."
  />

  <section class="privacy-band">
    <div>
      <h2>Your clipboard history stays on your computer, with explicit protection limits.</h2>
    </div>
    <p>
      mclip does not upload clipboard contents. The in-development v0.2.0 masks detected sensitive text by default, but history remains local plaintext: masking is not encryption at rest, and heuristic detection or source exclusions are not DLP or breach-prevention guarantees.
    </p>
  </section>

  <InstallGuide
    id="install"
    title="Start with GitHub Releases"
    intro="Downloads stay direct, and the current macOS notarization and Windows signing limitations are visible before install."
    items={installItems}
  />

  <Faq
    id="faq"
    title="Common questions before installing"
    summary="Signing, notarization, WebView2, and the local data boundary are visible before anyone downloads the app."
    items={faqItems}
  />

  <SiteFooter lang="en" />
</SiteLayout>
