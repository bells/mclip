---
import AgentCliSection from "../../components/AgentCliSection.astro";
import Faq from "../../components/Faq.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import Hero from "../../components/Hero.astro";
import InstallGuide from "../../components/InstallGuide.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  {
    title: "Open from the tray",
    body: "Click the menu bar or system tray icon. Open mclip when you need it, then get back to work.",
  },
  {
    title: "Text, images, and files",
    body: "Keep snippets, screenshots, and files together. File history restores a system file list; details show the full absolute path and name.",
  },
  {
    title: "Independent previews",
    body: "Preview without widening the main window. Open images in a dedicated viewer, maximize or restore, and close with Escape.",
  },
  {
    title: "Keyboard first",
    body: "Type to search, use arrow keys to select, and press Enter to copy. Pin the items you reach for most.",
  },
  {
    title: "Local by default",
    body: "Your clipboard history stays on your computer. Sensitive-text masking and source-app exclusions are optional local controls.",
  },
  {
    title: "Three platforms",
    body: "Available for macOS, Windows, and Linux. Follow the system theme and choose Chinese, English, or Japanese.",
  },
];

const agentCliPoints = [
  {
    title: "Context in one command",
    body: "Agent Mode bundles recent history, command capabilities, and safety boundaries.",
  },
  {
    title: "Read first, act explicitly",
    body: "Read commands leave history untouched. Copy, pin, and clear are separate actions.",
  },
  {
    title: "Composable text tools",
    body: "Transform JSON, Base64, or URL components through stdin and stdout.",
  },
];

const installItems = [
  {
    title: "macOS",
    format: "ARM64 · DMG",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_aarch64.dmg",
    body: "Open the DMG and drag mclip.app into Applications. Not notarized; macOS may quarantine the first launch.",
  },
  {
    title: "Windows",
    format: "x64 · EXE / MSI",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_x64-setup.exe",
    alternatives: [{ label: "MSI", href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_x64_en-US.msi" }],
    body: "Run the EXE or MSI installer. Unsigned; Windows SmartScreen may show an unknown-publisher warning.",
  },
  {
    title: "Linux",
    format: "x86_64 · DEB / AppImage",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_amd64.deb",
    alternatives: [{ label: "AppImage", href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_amd64.AppImage" }],
    body: "Linux x86_64 preview with DEB and AppImage. Tray, shortcuts, auto-paste, source identity, and positioning vary by desktop session. No ARM64 packages.",
  },
];

const faqItems = [
  {
    question: "Does mclip upload my clipboard contents?",
    answer: "No. History, settings, and generated image assets stay on your computer in the local app configuration directory. The Windows installer may only access the network to install WebView2 when it is missing.",
  },
  {
    question: "Is sensitive-content masking encryption?",
    answer: "No. The v0.2.0 mask protects the UI and default CLI output, while original history remains local plaintext so copy stays exact. Detection and source identity are best-effort and can produce false results; source-application exclusion is currently unavailable on pure Wayland.",
  },
  {
    question: "What if macOS says the app is damaged?",
    answer: "The current macOS build uses ad-hoc signing and is not notarized with an Apple Developer ID. After dragging mclip.app into Applications, you can run xattr -dr com.apple.quarantine /Applications/mclip.app if you trust the release.",
  },
  {
    question: "Is the Windows SmartScreen warning expected?",
    answer: "Yes for now. The Windows package is not code-signed yet, so SmartScreen may warn about an unknown publisher. Install only GitHub Releases you trust.",
  },
  {
    question: "How many items can mclip keep?",
    answer: "New installs keep up to 200 items by default, configurable from 10 to 1000. Main-window and archive-group counts are separate, and mclip can save text, images, files, or only selected types. The pin limit defaults to 10, adjustable from 5 to 20 in History settings. Lowering it keeps existing pins; pins do not consume ordinary history or display counts.",
  },
];
---

<SiteLayout
  lang="en"
  path="/en/"
  title="mclip - Lightweight, local-first clipboard history"
  description="mclip is a local-first clipboard history app for macOS, Windows, and Linux, with text, image, and file history, independent previews, tray shortcuts, and an AI Agent CLI with Agent Mode."
  faqItems={faqItems}
>
  <Hero
    lang="en"
    title="Copy once."
    titleAccent="Find it again."
    description="Text, images, and files. Search your clipboard history, preview what you need, and copy it back."
    primaryCta="Download mclip"
    secondaryCta="View on GitHub"
    utilityLabel="macOS · Windows · Linux"
    proofItems={["Text · Images · Files", "Local history", "Open source"]}
  />

  <main>
    <FeatureGrid
      id="features"
      title="Keep copy history close."
      features={features}
    />

    <AgentCliSection
      id="agents"
      title="AI Agent and CLI"
      summary="Give Codex, Claude Code, Cursor, and Cline local context from what you already copied. mclip-cli reads your history and returns Markdown or JSON."
      installLabel="Install mclip-cli"
      installCommand="curl -fsSL https://www.mclip.cn/install.sh | sh"
      exampleLabel="Common commands"
      examples={[
        "mclip-cli agent --last 5 --json",
        "mclip-cli list --limit 5 --json",
        "mclip-cli context --last 3 --format markdown",
        "mclip-cli add \"note from agent\"",
        "mclip-cli copy --index 1",
        "printf '%s' '{\"ok\":true}' | mclip-cli transform json-prettify",
        "printf '%s' 'pipeline clipboard text' | mclip-cli copy",
        "mclip-cli pin --id h_xxx",
        "mclip-cli list --pinned --json",
        "mclip-cli list --json --with-meta",
      ]}
      installNoteLabel="CLI installation notes · Git Bash on Windows"
      moreLabel="More commands"
      points={agentCliPoints}
      note="The installer downloads the prebuilt mclip-cli and SHA-256 companion from the same GitHub Release, verifies it before replacing an older CLI, and accepts MCLIP_VERSION for pinned installs. It falls back to a source build only when the binary asset is missing. Windows CLI users should run it from Git Bash or another POSIX-compatible shell."
    />

    <section class="privacy-band">
      <div>
        <h2>Your clipboard history stays on your computer.</h2>
      </div>
      <p>
        mclip does not upload clipboard contents. v0.2.0 masks detected sensitive text by default, but history remains local plaintext: masking is not encryption at rest, and heuristic detection or source exclusions are not DLP or breach-prevention guarantees.
      </p>
    </section>

    <InstallGuide
      id="install"
      title="Download v0.2.0"
      intro="Choose a package for your platform. Installation notes are listed below."
      downloadLabel="Download"
      releaseNote="v0.2.0 was published on September 19, 2026 and is available from GitHub Releases."
      releaseLabel="All release assets"
      sourceLabel="Source code"
      items={installItems}
    />

    <Faq
      id="faq"
      title="Common questions before installing"
      summary="Installation, privacy, and everyday use."
      items={faqItems}
    />

  </main>

  <SiteFooter lang="en" />
</SiteLayout>
