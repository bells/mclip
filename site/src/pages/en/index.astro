---
import AgentCliSection from "../../components/AgentCliSection.astro";
import Faq from "../../components/Faq.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import Hero from "../../components/Hero.astro";
import InstallGuide from "../../components/InstallGuide.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  {
    title: "Tray-first",
    body: "Click the menu bar or system tray icon, or press CommandOrControl+Shift+V. The window appears when needed and gets out of the way after.",
  },
  {
    title: "Text, images, and files",
    body: "mclip keeps the everyday things you copy: text snippets, screenshots, and files from Finder or File Explorer. Selecting file history restores a system file list, not just path text.",
  },
  {
    title: "Separate preview windows",
    body: "The latest 10 items stay compact and older history stays grouped. Long file names are middle-ellipsized in lists, while details show the full absolute path.",
  },
  {
    title: "Search and keyboard flow",
    body: "Type to filter, use arrow keys to move, press Enter to copy, and hit Escape to hide the window.",
  },
  {
    title: "Local-first privacy",
    body: "Clipboard history, settings, and image assets stay on your computer. mclip does not upload clipboard contents.",
  },
  {
    title: "Bilingual and cross-platform",
    body: "mclip supports macOS and Windows, with Chinese and English UI selected from the system language on first launch.",
  },
];

const agentCliPoints = [
  {
    title: "Give agents local context",
    body: "mclip-cli list --limit 5 --json exposes recent history as structured JSON for Codex, Claude Code, Cursor, and Cline.",
  },
  {
    title: "Read-only and quiet",
    body: "The first CLI phase only reads the local history.json file. It does not open the desktop UI or modify clipboard history.",
  },
  {
    title: "Built for errors, code, and prompts",
    body: "Text, JSON, raw, and Markdown output make copied errors, code snippets, and recent context easier to pass into an AI Agent.",
  },
];

const installItems = [
  {
    title: "macOS",
    body: "Download the DMG from GitHub Releases and drag mclip.app into Applications. The current build is not notarized, so macOS may quarantine it after browser download.",
  },
  {
    title: "Windows",
    body: "Download the MSI or EXE installer and follow the setup wizard. The current installer is unsigned, so Windows SmartScreen may show an unknown-publisher warning.",
  },
  {
    title: "Developers",
    body: "The source code is open on GitHub. The app uses Tauri 2, React 19, TypeScript, and Rust, and runs locally with npm run tauri:dev.",
  },
];

const faqItems = [
  {
    question: "Does mclip upload my clipboard contents?",
    answer: "No. History, settings, and generated image assets stay on your computer in the local app configuration directory. The Windows installer may only access the network to install WebView2 when it is missing.",
  },
  {
    question: "What if macOS says the app is damaged?",
    answer: "The current macOS build uses ad-hoc signing and is not notarized with an Apple Developer ID. After dragging mclip.app into Applications, you can run xattr -dr com.apple.quarantine /Applications/mclip.app if you trust the release.",
  },
  {
    question: "Is the Windows SmartScreen warning expected?",
    answer: "Yes for now. The Windows package is not code-signed yet, so SmartScreen may warn about an unknown publisher. Install only GitHub Releases you trust.",
  },
  {
    question: "How many items can mclip keep?",
    answer: "You can adjust the maximum history count in Preferences, and you can choose whether mclip saves text, images, files, or only some of them.",
  },
];
---

<SiteLayout
  lang="en"
  path="/en/"
  title="mclip - Lightweight, local-first clipboard history"
  description="mclip is a lightweight, local-first clipboard history app for macOS and Windows, with text, image, file history, search, previews, and tray shortcuts."
  faqItems={faqItems}
>
  <Hero
    lang="en"
    title="Lightweight, local-first clipboard history"
    description="mclip lives in the menu bar or system tray. Open it when you need a previous text snippet, image, or file, then return to work without a large window taking over."
    primaryCta="Download mclip"
    secondaryCta="View on GitHub"
    note="Current version 0.1.0. Downloads are served from GitHub Releases."
    utilityLabel="Menu bar utility for macOS and Windows"
    proofItems={[
      "Main window shows the latest 10 items",
      "Keeps text, images, and files",
      "History and settings stay local",
    ]}
  />

  <FeatureGrid
    id="features"
    title="Keep copy history close without adding noise"
    summary="The page mirrors the product flow: open the tray window, search, preview, copy, then get back to the task you were doing."
    features={features}
  />

  <AgentCliSection
    id="agents"
    eyebrow="For developers and AI agents"
    title="AI Agent and CLI"
    summary="mclip-cli gives Codex, Claude Code, Cursor, and Cline a read-only terminal entry into local clipboard history. Agents can fetch recent context without asking you to paste the same error or snippet again."
    installLabel="Install mclip-cli"
    installCommand="curl -fsSL https://mclip.vercel.app/install.sh | sh"
    exampleLabel="Common commands"
    examples={[
      "mclip-cli list --limit 5 --json",
      "mclip-cli context --last 3 --format markdown",
    ]}
    points={agentCliPoints}
    note="The current installer builds mclip-cli from source, so Rust/Cargo and Git are required for now."
  />

  <section class="privacy-band">
    <div>
      <h2>Your clipboard history stays on your computer.</h2>
    </div>
    <p>
      mclip is a desktop utility, not a cloud service. History files, settings, and image assets live in the local app configuration directory.
    </p>
  </section>

  <InstallGuide
    id="install"
    title="Start with GitHub Releases"
    intro="The first public site stays honest: download is direct, and the current macOS notarization and Windows signing limitations are visible before install."
    items={installItems}
  />

  <Faq
    id="faq"
    title="Common questions before installing"
    summary="Signing, notarization, WebView2, and the local data boundary are visible before anyone downloads the app."
    items={faqItems}
  />

  <SiteFooter lang="en" />
</SiteLayout>
