---
import AgentCliSection from "../../components/AgentCliSection.astro";
import Faq from "../../components/Faq.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import Hero from "../../components/Hero.astro";
import InstallGuide from "../../components/InstallGuide.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  {
    title: "托盘优先",
    body: "点击菜单栏或系统托盘图标，或者按 CommandOrControl+Shift+V 即可唤起。v0.1.1 只让主窗口进入启动关键路径，preview 预热、低频窗口按需创建；Apple M2 实测托盘就绪中位数缩短 51.3%。",
  },
  {
    title: "文本、图片、文件都能找回",
    body: "保存常见复制场景：一段文字、一张截图、Finder 或资源管理器里的文件。选择文件历史时会回填系统文件列表，而不是只复制绝对路径；详情仍会显示完整绝对路径和文件名。",
  },
  {
    title: "紧凑的独立预览",
    body: "最新 10 条默认保持紧凑，文本/文件行不会挤占图片高度；更多历史默认按 10 条分组，hover 详情保持独立。图片详情可在独立查看器中最大化查看、恢复，并用 Escape 关闭。",
  },
  {
    title: "搜索和键盘操作",
    body: "输入关键词即可过滤历史，方向键移动，回车复制，Esc 收起。搜索、键盘和鼠标共用同一个激活目标，主列表、分组和底部操作不会出现两套高亮。",
  },
  {
    title: "本地优先",
    body: "剪贴板历史、设置和图片资源只保存在本机。mclip 不上传剪贴板内容。",
  },
  {
    title: "主题、语言和跨平台",
    body: "支持 macOS 和 Windows，界面可跟随系统深浅色与系统语言；新安装默认保留 200 条、最多可调到 500 条，还可调整主界面/分组条数、序号和主窗口 Logo，并在 Agent CLI 页安全安装、升级或重装匹配版本。",
  },
];

const agentCliPoints = [
  {
    title: "Agent 模式一条命令",
    body: "mclip-cli agent --last 5 --json 会输出最近历史、命令能力表和安全边界，适合 Codex、Claude Code、Cursor、Cline 直接读取。",
  },
  {
    title: "受控操作，不抢桌面",
    body: "agent/list/get/search/context 只读；add 只写入历史不覆盖系统剪贴板；copy 才会把指定历史项写回剪贴板。",
  },
  {
    title: "适合错误、代码和 Prompt",
    body: "Agent 模式默认输出 Markdown，也支持 JSON；普通命令支持 text、JSON、raw、Markdown，方便把报错、代码片段和最近上下文交给 AI Agent。",
  },
];

const installItems = [
  {
    title: "macOS",
    body: "从 GitHub Releases 下载 DMG，把 mclip.app 拖入应用程序。当前版本未 notarize，如系统提示应用已损坏，可在确认信任后解除 quarantine。",
  },
  {
    title: "Windows",
    body: "下载 MSI 或 EXE 安装包后按向导安装。当前版本未代码签名，Windows SmartScreen 可能提示未知发布者。",
  },
  {
    title: "开发者",
    body: "源码在 GitHub 开放。项目使用 Tauri 2、React 19、TypeScript 和 Rust，可通过 npm run tauri:dev 本地运行。",
  },
];

const faqItems = [
  {
    question: "mclip 会上传我的剪贴板内容吗？",
    answer: "不会。历史记录、设置和图片历史资源只保存在本机系统配置目录里。Windows 安装器仅在缺少 WebView2 运行时时可能联网下载运行时组件。",
  },
  {
    question: "macOS 首次打开提示应用已损坏怎么办？",
    answer: "当前 macOS 包使用 ad-hoc 签名，没有 Apple Developer ID notarization。把 mclip.app 拖入应用程序后，如果你信任该 Release，可以执行 xattr -dr com.apple.quarantine /Applications/mclip.app。",
  },
  {
    question: "Windows SmartScreen 提示未知发布者正常吗？",
    answer: "正常。当前 Windows 包还没有代码签名证书，所以 SmartScreen 可能提示未知发布者。请只安装你信任的 GitHub Release。",
  },
  {
    question: "历史能保存多少条？",
    answer: "新安装默认最多保存 200 条，可在偏好设置里调整为 10–500 条；主界面展示条数和历史分组展示条数可独立调整，也可以只保存文本、图片或文件中的一部分类型。",
  },
];
---

<SiteLayout
  lang="zh-CN"
  path="/zh/"
  title="mclip - 轻量、本地优先的剪贴板历史工具"
  description="mclip 是面向 macOS 和 Windows 的本地优先剪贴板历史工具，支持文本、图片、文件历史、搜索、独立预览、托盘快捷唤起和带 Agent 模式的 AI Agent CLI。"
  faqItems={faqItems}
>
  <Hero
    lang="zh"
    title="轻量、本地优先的剪贴板历史工具"
    description="mclip 常驻菜单栏或系统托盘。需要时一键唤起，快速搜索文字、图片和文件历史，用完继续回到手头工作。"
    primaryCta="下载 mclip"
    secondaryCta="查看 GitHub"
    note="当前版本 0.1.1，下载入口指向 GitHub Releases。"
    utilityLabel="macOS 菜单栏 · Windows 系统托盘"
    proofItems={[
      "Apple M2 实测托盘就绪中位数提升 51.3%",
      "文本、图片、文件与独立大图查看",
      "增量更新、图片缓存，内容仍只留本机",
    ]}
  />

  <FeatureGrid
    id="features"
    title="把复制历史放在手边，但不打扰你"
    summary="mclip 的界面按真实使用路径组织：唤起、搜索、预览、复制，然后回到原来的工作。"
    features={features}
  />

  <AgentCliSection
    id="agents"
    eyebrow="面向开发者和 AI Agent"
    title="AI Agent 与 CLI"
    summary="mclip-cli 是给 Codex、Claude Code、Cursor、Cline 等 AI Agent 使用的本地入口。Agent 模式会把最近剪贴板历史、可用命令和安全边界打包输出，不需要你反复手动粘贴。"
    installLabel="安装 mclip-cli"
    installCommand="curl -fsSL https://www.mclip.cn/install.sh | sh"
    exampleLabel="常用命令"
    examples={[
      "mclip-cli agent --last 5 --json",
      "mclip-cli list --limit 5 --json",
      "mclip-cli context --last 3 --format markdown",
      "mclip-cli add \"note from agent\"",
      "mclip-cli copy --index 1",
    ]}
    points={agentCliPoints}
    note="安装脚本会下载同一 GitHub Release 的预构建 mclip-cli 与 SHA-256 校验资产，验证成功后才替换旧 CLI；可用 MCLIP_VERSION 固定版本。只有二进制资产不存在时才回退到源码构建。Windows CLI 用户请在 Git Bash 或兼容 POSIX shell 中运行。"
  />

  <section class="privacy-band">
    <div>
      <h2>你的剪贴板历史只保存在本机。</h2>
    </div>
    <p>
      mclip 的目标是做一个可信的小工具，而不是云服务。历史文件、设置文件和图片资源都保存在本机应用配置目录。
    </p>
  </section>

  <InstallGuide
    id="install"
    title="先从 GitHub Release 开始"
    intro="官网直接说明下载方式，也明确当前 macOS 未 notarize、Windows 未签名。"
    items={installItems}
  />

  <Faq
    id="faq"
    title="安装前常见问题"
    summary="这些问题不藏在脚注里。签名、公证、WebView2 和本地数据边界都应该在下载前看得到。"
    items={faqItems}
  />

  <SiteFooter lang="zh" />
</SiteLayout>
