---
import AgentCliSection from "../../components/AgentCliSection.astro";
import Faq from "../../components/Faq.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import Hero from "../../components/Hero.astro";
import InstallGuide from "../../components/InstallGuide.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  {
    title: "从托盘，随手唤起",
    body: "点击菜单栏或系统托盘图标，需要时打开，用完回到手头工作。",
  },
  {
    title: "文字、图片、文件",
    body: "找回片段、截图和文件。文件历史回填系统文件列表，详情显示完整绝对路径和文件名。",
  },
  {
    title: "独立预览，清晰查看",
    body: "预览不撑宽主窗口。图片可在独立查看器中最大化、恢复，按 Esc 关闭。",
  },
  {
    title: "键盘操作，一气呵成",
    body: "输入搜索，方向键选择，回车复制。常用内容置顶，下次不用再找。",
  },
  {
    title: "内容留在本机",
    body: "剪贴板历史只保存在本机。可开启敏感文本遮罩，也可排除指定来源应用。",
  },
  {
    title: "三个平台，同样顺手",
    body: "支持 macOS、Windows 和 Linux。外观可跟随系统，界面支持中文、英文和日文。",
  },
];

const agentCliPoints = [
  {
    title: "一条命令获取上下文",
    body: "Agent 模式打包最近历史、命令能力表和安全边界。",
  },
  {
    title: "先读取，再明确操作",
    body: "读取命令不修改历史；复制、置顶、清空是独立操作。",
  },
  {
    title: "可以组合的文本工具",
    body: "通过标准输入输出转换 JSON、Base64 和 URL 组件。",
  },
];

const installItems = [
  {
    title: "macOS",
    format: "ARM64 · DMG",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_aarch64.dmg",
    body: "下载 DMG，把 mclip.app 拖入应用程序。当前版本未公证，首次打开可能需要解除系统隔离。",
  },
  {
    title: "Windows",
    format: "x64 · EXE / MSI",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_x64-setup.exe",
    alternatives: [{ label: "MSI", href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_x64_en-US.msi" }],
    body: "下载 EXE 或 MSI，按向导安装。当前版本未签名，Windows SmartScreen 可能提示未知发布者。",
  },
  {
    title: "Linux",
    format: "x86_64 · DEB / AppImage",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_amd64.deb",
    alternatives: [{ label: "AppImage", href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_amd64.AppImage" }],
    body: "Linux x86_64 预览版，提供 DEB 和 AppImage。托盘、快捷键、自动粘贴和来源识别等能力随桌面会话而异；暂不提供 ARM64 包。",
  },
];

const faqItems = [
  {
    question: "mclip 会上传我的剪贴板内容吗？",
    answer: "不会。历史记录、设置和图片历史资源只保存在本机系统配置目录里。Windows 安装器仅在缺少 WebView2 运行时时可能联网下载运行时组件。",
  },
  {
    question: "敏感内容遮罩等于加密吗？",
    answer: "不等于。v0.2.0 的遮罩只保护界面和默认 CLI 输出，原始历史仍以本地明文保存，以保证复制内容不变。检测与来源应用识别都是 best-effort，可能误报或漏报；纯 Wayland 当前无法执行来源应用排除。",
  },
  {
    question: "macOS 首次打开提示应用已损坏怎么办？",
    answer: "当前 macOS 包使用 ad-hoc 签名，没有 Apple Developer ID notarization。把 mclip.app 拖入应用程序后，如果你信任该 Release，可以执行 xattr -dr com.apple.quarantine /Applications/mclip.app。",
  },
  {
    question: "Windows SmartScreen 提示未知发布者正常吗？",
    answer: "正常。当前 Windows 包还没有代码签名证书，所以 SmartScreen 可能提示未知发布者。请只安装你信任的 GitHub Release。",
  },
  {
    question: "历史能保存多少条？",
    answer: "新安装默认最多保存 200 条，可在偏好设置里调整为 10–1000 条；主界面展示条数和历史分组展示条数可独立调整，也可以只保存文本、图片或文件中的一部分类型。 置顶上限默认为 10 条，可在历史设置中调整为 5–20；降低上限保留已有置顶，置顶不占普通历史和列表展示条数。",
  },
];
---

<SiteLayout
  lang="zh"
  path="/zh/"
  title="mclip - 轻量、本地优先的剪贴板历史工具"
  description="mclip 是面向 macOS、Windows 和 Linux 的本地优先剪贴板历史工具，支持文本、图片、文件历史、搜索、独立预览、托盘快捷唤起和带 Agent 模式的 AI Agent CLI。"
  faqItems={faqItems}
>
  <Hero
    lang="zh"
    title="复制过的，"
    titleAccent="随时找回来。"
    description="文字、图片、文件，留在本机。需要时唤起，搜索、预览，再复制回手头的工作。"
    primaryCta="下载 mclip"
    secondaryCta="查看 GitHub"
    utilityLabel="macOS · Windows · Linux"
    proofItems={["文字 · 图片 · 文件", "本地保存", "开源"]}
  />

  <main>
    <FeatureGrid
      id="features"
      title="复制历史，就在手边。"
      features={features}
    />

    <AgentCliSection
      id="agents"
      title="AI Agent 与 CLI"
      summary="让 Codex、Claude Code、Cursor、Cline 读取你已经复制的本地上下文。mclip-cli 输出 Markdown 或 JSON，省去反复粘贴。"
      installLabel="安装 mclip-cli"
      installCommand="curl -fsSL https://www.mclip.cn/install.sh | sh"
      exampleLabel="常用命令"
      examples={[
        "mclip-cli agent --last 5 --json",
        "mclip-cli list --limit 5 --json",
        "mclip-cli context --last 3 --format markdown",
        "mclip-cli add \"note from agent\"",
        "mclip-cli copy --index 1",
        "printf '%s' '{\"ok\":true}' | mclip-cli transform json-prettify",
        "printf '%s' 'pipeline clipboard text' | mclip-cli copy",
        "mclip-cli pin --id h_xxx",
        "mclip-cli list --pinned --json",
        "mclip-cli list --json --with-meta",
      ]}
      installNoteLabel="CLI 安装说明 · Windows 请用 Git Bash"
      moreLabel="更多命令"
      points={agentCliPoints}
      note="安装脚本会下载同一 GitHub Release 的预构建 mclip-cli 与 SHA-256 校验资产，验证成功后才替换旧 CLI；可用 MCLIP_VERSION 固定版本。只有二进制资产不存在时才回退到源码构建。Windows CLI 用户请在 Git Bash 或兼容 POSIX shell 中运行。"
    />

    <section class="privacy-band">
      <div>
        <h2>你的剪贴板，留在你的电脑。</h2>
      </div>
      <p>
        mclip 不上传剪贴板内容。v0.2.0 默认遮罩检测到的敏感文本，但历史仍是本地明文；遮罩不是静态加密，启发式检测和来源应用排除也不是 DLP 或泄露防护保证。
      </p>
    </section>

    <InstallGuide
      id="install"
      title="下载 v0.2.0"
      intro="选择适合你平台的安装包，安装注意事项见下方。"
      downloadLabel="下载"
      releaseNote="v0.2.0 已于 2026-09-19 正式发布，可从 GitHub Release 下载。"
      releaseLabel="全部发布资产"
      sourceLabel="查看源码"
      items={installItems}
    />

    <Faq
      id="faq"
      title="安装前常见问题"
      summary="关于安装、隐私和日常使用。"
      items={faqItems}
    />

  </main>

  <SiteFooter lang="zh" />
</SiteLayout>
