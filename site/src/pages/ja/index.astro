---
import AgentCliSection from "../../components/AgentCliSection.astro";
import Faq from "../../components/Faq.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import Hero from "../../components/Hero.astro";
import InstallGuide from "../../components/InstallGuide.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  {
    title: "トレイからすぐに開く",
    body: "メニューバーまたはシステムトレイをクリック。必要なときだけ開き、すぐ元の作業へ戻れます。",
  },
  {
    title: "テキスト、画像、ファイル",
    body: "コピーした内容をまとめて保存。ファイルはシステムのファイル一覧として復元し、詳細には完全な絶対パスと名前を表示します。",
  },
  {
    title: "独立したプレビュー",
    body: "メインウィンドウを広げずに確認。画像は専用ビューアで最大化、復元でき、Esc で閉じられます。",
  },
  {
    title: "キーボードで素早く",
    body: "入力して検索、矢印キーで選択、Enter でコピー。よく使う内容はピン留めできます。",
  },
  {
    title: "履歴はこの端末に",
    body: "履歴はこのコンピューターだけに保存。機密テキストのマスクやコピー元アプリの除外を設定できます。",
  },
  {
    title: "3 つのプラットフォーム",
    body: "macOS、Windows、Linux に対応。外観はシステムに従い、中国語、英語、日本語を選べます。",
  },
];

const agentCliPoints = [
  {
    title: "1 コマンドでコンテキスト取得",
    body: "Agent Mode は最近の履歴、コマンド機能、安全境界をまとめます。",
  },
  {
    title: "読み取りと操作を分ける",
    body: "読み取りコマンドは履歴を変更しません。コピー、ピン留め、消去は個別の操作です。",
  },
  {
    title: "組み合わせられるテキスト変換",
    body: "標準入出力で JSON、Base64、URL コンポーネントを変換します。",
  },
];

const installItems = [
  {
    title: "macOS",
    format: "ARM64 · DMG",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_aarch64.dmg",
    body: "DMG を開き、mclip.app をアプリケーションへドラッグ。公証されていないため、初回起動時に macOS が隔離する場合があります。",
  },
  {
    title: "Windows",
    format: "x64 · EXE / MSI",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_x64-setup.exe",
    alternatives: [{ label: "MSI", href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_x64_en-US.msi" }],
    body: "EXE または MSI でインストール。未署名のため、Windows SmartScreen が警告する場合があります。",
  },
  {
    title: "Linux",
    format: "x86_64 · DEB / AppImage",
    href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_amd64.deb",
    alternatives: [{ label: "AppImage", href: "https://github.com/bells/mclip/releases/download/v0.2.0/mclip_0.2.0_amd64.AppImage" }],
    body: "Linux x86_64 プレビュー。DEB と AppImage を提供。トレイ、ショートカット、自動ペースト、コピー元識別、位置調整はセッションで異なります。ARM64 は未提供です。",
  },
];

const faqItems = [
  {
    question: "mclip はクリップボードの内容をアップロードしますか？",
    answer: "いいえ。履歴、設定、生成した画像アセットはローカルのアプリ設定ディレクトリに保存されます。Windows インストーラーは WebView2 がない場合に限り、そのランタイムを取得するためネットワークへ接続することがあります。",
  },
  {
    question: "機密内容のマスクは暗号化ですか？",
    answer: "いいえ。v0.2.0 のマスクは画面と既定の CLI 出力を保護しますが、正確なコピーを保つため元の履歴はローカルに平文で残ります。検出とコピー元識別はベストエフォートで、誤った結果になる可能性があります。純粋な Wayland ではコピー元アプリの除外を現在利用できません。",
  },
  {
    question: "macOS でアプリが破損していると表示されたら？",
    answer: "現在の macOS ビルドは ad-hoc 署名で、Apple Developer ID による notarization は行っていません。mclip.app をアプリケーションへ移動し、その Release を信頼できる場合は xattr -dr com.apple.quarantine /Applications/mclip.app を実行できます。",
  },
  {
    question: "Windows SmartScreen の警告は想定内ですか？",
    answer: "現時点では想定内です。Windows パッケージはまだコード署名されていないため、不明な発行元として警告される場合があります。信頼できる GitHub Release だけをインストールしてください。",
  },
  {
    question: "履歴は何件保存できますか？",
    answer: "新規インストールでは既定で最大 200 件、10～1000 件の範囲で設定できます。メインウィンドウと履歴グループの表示件数は別々に設定でき、テキスト、画像、ファイルから保存する種類も選べます。 ピン留めは既定で 10 件、履歴設定で 5〜20 件に変更できます。上限を下げても既存項目を保持し、通常履歴や表示件数には含まれません。",
  },
];
---

<SiteLayout
  lang="ja"
  path="/ja/"
  title="mclip - 軽量でローカルファーストなクリップボード履歴"
  description="mclip は macOS、Windows、Linux 向けのローカルファーストなクリップボード履歴アプリです。テキスト、画像、ファイルの履歴、独立したプレビュー、トレイショートカット、Agent Mode 対応の AI Agent CLI を備えています。"
  faqItems={faqItems}
>
  <Hero
    lang="ja"
    title="コピーしたものを、"
    titleAccent="もう一度手元に。"
    description="テキスト、画像、ファイルをローカルに保存。検索して確認し、必要な内容をすぐにコピー。"
    primaryCta="mclip をダウンロード"
    secondaryCta="GitHub で見る"
    utilityLabel="macOS · Windows · Linux"
    proofItems={["テキスト · 画像 · ファイル", "ローカル保存", "オープンソース"]}
  />

  <main>
    <FeatureGrid
      id="features"
      title="コピー履歴を、すぐ手元に。"
      features={features}
    />

    <AgentCliSection
      id="agents"
      title="AI Agent と CLI"
      summary="Codex、Claude Code、Cursor、Cline にコピー済みのローカル情報を渡せます。mclip-cli は Markdown や JSON を出力します。CLI のヘルプと出力は引き続き英語です。"
      installLabel="mclip-cli をインストール"
      installCommand="curl -fsSL https://www.mclip.cn/install.sh | sh"
      exampleLabel="よく使うコマンド"
      examples={[
        "mclip-cli agent --last 5 --json",
        "mclip-cli list --limit 5 --json",
        "mclip-cli context --last 3 --format markdown",
        "mclip-cli add \"note from agent\"",
        "mclip-cli copy --index 1",
        "printf '%s' '{\"ok\":true}' | mclip-cli transform json-prettify",
        "printf '%s' 'pipeline clipboard text' | mclip-cli copy",
        "mclip-cli pin --id h_xxx",
        "mclip-cli list --pinned --json",
        "mclip-cli list --json --with-meta",
      ]}
      installNoteLabel="CLI インストールの注意 · Windows は Git Bash"
      moreLabel="その他のコマンド"
      points={agentCliPoints}
      note="インストーラーは同じ GitHub Release からビルド済み mclip-cli と SHA-256 ファイルを取得し、古い CLI を置換する前に検証します。MCLIP_VERSION でバージョンを固定でき、バイナリアセットがない場合だけソースビルドへ切り替えます。Windows では Git Bash など POSIX 互換シェルから実行してください。"
    />

    <section class="privacy-band">
      <div>
        <h2>クリップボード履歴は、このコンピューターに。</h2>
      </div>
      <p>
        mclip はクリップボード内容をアップロードしません。v0.2.0 は検出した機密テキストを既定でマスクしますが、履歴はローカルの平文です。マスクは保存時の暗号化ではなく、ヒューリスティック検出やコピー元除外も DLP や漏えい防止を保証しません。
      </p>
    </section>

    <InstallGuide
      id="install"
      title="v0.2.0 をダウンロード"
      intro="プラットフォームに合ったパッケージを選び、以下の注意事項をご確認ください。"
      downloadLabel="ダウンロード"
      releaseNote="v0.2.0 は 2026 年 9 月 19 日に正式公開され、GitHub Releases からダウンロードできます。"
      releaseLabel="すべての配布ファイル"
      sourceLabel="ソースコード"
      items={installItems}
    />

    <Faq
      id="faq"
      title="インストール前のよくある質問"
      summary="インストール、プライバシー、日常の使い方。"
      items={faqItems}
    />

  </main>

  <SiteFooter lang="ja" />
</SiteLayout>
